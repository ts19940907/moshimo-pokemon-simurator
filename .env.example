EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Shared site password (no signup). Leave empty to disable the login gate locally.
# On Vercel, set this for Production (and Preview if desired). Value is public in the web bundle.
# Native (iOS/Android): face or fingerprint is also required after the password.
# Web: platform WebAuthn (Touch ID / Windows Hello / phone biometrics) is also required.
# WebAuthn needs HTTPS (or localhost). Unsupported browsers cannot proceed.
EXPO_PUBLIC_APP_PASSWORD=
